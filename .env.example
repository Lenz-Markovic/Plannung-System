# Copy this file to ".env" and fill in the values. ".env" is never committed.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# "sqlite" (default, file db.sqlite3) or "postgres"
DATABASE_ENGINE=sqlite
POSTGRES_DB=planung
POSTGRES_USER=planung
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# TomTom key: only used on the server, never sent to the browser.
TOMTOM_API_KEY=
